# =============================================================================
# DEPLOYMENT MODE CONFIGURATION
# =============================================================================
# Choose between:
#   'local' - Self-hosted Docker Compose (for local development)
#   'gce'   - Remote Weaviate + Ollama on GCE VM (for production)
DEPLOYMENT_MODE=local

# =============================================================================
# LOCAL MODE SETTINGS (when DEPLOYMENT_MODE=local)
# =============================================================================
# Local Weaviate URL (defaults to docker service name)
LOCAL_WEAVIATE_URL=http://weaviate:8080

# Ollama embedding model
OLLAMA_MODEL=bge-m3

# =============================================================================
# GCE MODE SETTINGS (when DEPLOYMENT_MODE=gce)
# =============================================================================
# These are automatically set by Cloud Build from the GCE VM static IP
# GCE_WEAVIATE_URL=http://<GCE_STATIC_IP>:8080
# GCE_OLLAMA_URL=http://<GCE_STATIC_IP>:11434

# =============================================================================
# CHAT API CONFIGURATION (used in both modes)
# =============================================================================
# Chat API endpoint and model
CHAT_API_ENDPOINT=https://api.openai.com/v1/chat/completions
CHAT_MODEL=gpt-4o-mini

# Chat API key (defaults to OPENAI_API_KEY if not set)
# CHAT_API_KEY=your_custom_api_key

# For Gemini:
# CHAT_API_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# CHAT_API_KEY=your_gemini_api_key
# CHAT_MODEL=gemini-2.0-flash

# =============================================================================
# POSTGRES / FAQ SEARCH (Django backend — reuses pg/faq_api data layer)
# =============================================================================
# The Django backend now performs FAQ semantic search in-process (the standalone
# FastAPI PG FAQ API is gone), so it needs the Postgres connection + an Ollama URL.
PGHOST=postgres
PGPORT=5432
PGDATABASE=faqdb
PGUSER=faq_user
PGPASSWORD=faq_password
# Ollama endpoint used to embed FAQ queries (docker service name in local mode).
OLLAMA_URL=http://ollama:11434
EMBEDDING_DIMENSION=1024

# =============================================================================
# DJANGO BACKEND SETTINGS
# =============================================================================
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=change-me-in-prod
# DJANGO_ALLOWED_HOSTS=*
# Multi-turn history is disabled by default (each message is a fresh conversation).
# ENABLE_HISTORY=false

# =============================================================================
# OTHER SETTINGS
# =============================================================================
# GitHub branch base URL (for document source links)
GITHUB_BRANCH_BASE_URL=https://github.com/study-iitm/iitmdocs/blob/main/
